# Ignore everything at the root level
/*

# Except the following directories and files
!/backend/
!/frontend/
!/docs/
!/README.md
!/.gitignore
!/assets/

# Subdirectory specific ignores

# Node.js (backend) ignores
**/node_modules/
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Flutter (frontend) ignores
**/.dart_tool/
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/coverage/

# OS/IDE metadata
**/.DS_Store
**/.idea/
**/*.iml
**/*.ipr
**/*.iws
**/.vscode/
**/*.log
